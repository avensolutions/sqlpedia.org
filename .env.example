# SQLpedia Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# AI Provider API Keys (Optional)
# ==============================================
# At least one AI provider key is required for AI features to work.
# If no keys are provided, the system will fall back to demo/mock responses.

# OpenAI API Key (for GPT-4, GPT-3.5)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (for Claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ==============================================
# Self-Hosted Model Configuration (Optional)
# ==============================================
# If you're using self-hosted models (Llama, CodeLlama, etc.)
# configure the endpoint here

# Self-hosted model endpoint
# SELF_HOSTED_MODEL_ENDPOINT=http://localhost:8000/v1/chat/completions

# Self-hosted model API key (if required)
# SELF_HOSTED_MODEL_API_KEY=your-api-key-here

# ==============================================
# Development Settings
# ==============================================

# Node environment
NODE_ENV=development

# ==============================================
# Production Settings (Netlify)
# ==============================================
# These should be set in Netlify Dashboard → Site settings → Environment variables
# Do NOT commit actual keys to git!

# Example Netlify configuration:
# 1. Go to Netlify Dashboard
# 2. Select your site
# 3. Go to Site settings → Environment variables
# 4. Add the following variables:
#    - OPENAI_API_KEY
#    - ANTHROPIC_API_KEY

# ==============================================
# Optional: Analytics
# ==============================================

# Google Analytics (optional)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================
# Notes
# ==============================================
# - Never commit .env file to git
# - Keep your API keys secure
# - Rotate keys regularly
# - Use different keys for development and production
# - Monitor API usage to avoid unexpected costs
